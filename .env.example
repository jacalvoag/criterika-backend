# Copiar a .env y completar con valores locales. Nunca usar el usuario migrador.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=criterika
DB_USER=criterika_api
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_DEL_LOGIN_LOCAL
# disable-local solo se admite en loopback y fuera de producción.
# Para cualquier conexión remota: verify-full.
DB_TLS_MODE=disable-local
# Ruta opcional a la CA de confianza del proveedor; usar / en rutas Windows.
DB_CA_FILE=
DB_POOL_MAX=10

# Requeridas al importar IdempotencyModule para inicio/abandono de intentos.
# Dos claves independientes de 32 bytes, codificadas en base64; mantener estables.
IDEMPOTENCY_HMAC_KEY_BASE64=
IDEMPOTENCY_ENCRYPTION_KEY_BASE64=

# Al activar RegistrationInfrastructureModule (no se activa en db:check).
# Cuatro claves distintas contando las dos de idempotencia anteriores.
REGISTRATION_CODE_HMAC_KEY_BASE64=
REGISTRATION_MAIL_KEY_BASE64=
# Ruta al PEM RSA privado (2048 bits o más). Nunca versionar la clave.
JWT_PRIVATE_KEY_FILE=
JWT_ISSUER=criterika-api
JWT_AUDIENCE=criterika-player
JWT_KEY_ID=player-v1
# SMTP exige TLS remoto; percent-encode usuario y contraseña en la URL.
SMTP_URL=
MAIL_FROM=
# Valores reales del responsable; faltantes bloquean el registro.
PRIVACY_RESPONSIBLE_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POSTAL_ADDRESS=

# Trabajador separado de correo/depuración. No modifica las claves ni el plazo de códigos.
REGISTRATION_WORK_INTERVAL_MS=5000
REGISTRATION_WORK_BATCH=20
